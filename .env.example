# GEMINI_API_KEY: Optional free-tier Gemini API key for server-side text/vision descriptions.
# Never expose this key in client-side code. If omitted or rate-limited, the deterministic
# Canvas optical + metadata template fallback runs automatically at zero cost.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_TEXT_MODEL: Optional model override for /api/generate-description so you can swap
# models in Vercel Environment Variables without redeploying.
GEMINI_TEXT_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
